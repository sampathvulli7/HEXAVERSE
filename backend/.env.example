# Copy this file to `.env` and adjust per-machine. Everything has a sane
# default (see app/config.py) — you only need entries you want to override.

# Use a Qdrant server instead of the embedded local DB (optional):
# QDRANT_URL=http://localhost:6333

# LLM serving (Phase 1+). Ollama's OpenAI-compatible endpoint by default:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b-instruct
# VISION_MODEL=qwen2.5vl:7b

# Speech-to-text accuracy/speed tradeoff (base | small | medium):
# WHISPER_MODEL=small

# Cross-format links: similarity threshold and max links per chunk:
# RELATED_MIN_SCORE=0.55
# RELATED_MAX_LINKS=3

# Where uploaded files + the vector DB live (default: backend/storage):
# STORAGE_DIR=/absolute/path/to/storage
